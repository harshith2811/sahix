# SAHIX Digital Software - Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase Integration (when connecting live database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Notification Integration (Resend / SendGrid)
RESEND_API_KEY=re_123456789
ADMIN_NOTIFICATION_EMAIL=admin@sahix.digital

# WhatsApp Business Direct
NEXT_PUBLIC_WHATSAPP_NUMBER=+15551234567
